APP_NAME=TVShowsAPI
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:9012
APP_KEY=

JWT_SECRET=
JWT_TTL=120

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tvshow
DB_USERNAME=postgres
DB_PASSWORD=postgres

POSTGRES_DB=tvshow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_FORWARD_PORT=5433

CACHE_STORE=array
SESSION_DRIVER=array
LOG_CHANNEL=stack
LOG_LEVEL=debug
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

APP_PORT=9012

# Opcional: force UID/GID do processo dentro do container.
# DOCKER_UID=1000
# DOCKER_GID=1000

RUN_COMPOSER_INSTALL=true
RUN_MIGRATIONS=true
GENERATE_SWAGGER=true
DB_WAIT_RETRIES=30

TVMAZE_CLIENT_BASE_URL='https://api.tvmaze.com'
TVMAZE_CLIENT_API_BASE_PATH=''
TVMAZE_QUEUE_MAX_ATTEMPTS=6
TVMAZE_QUEUE_BACKOFF_SECONDS=5,15,30,60,120
TVMAZE_QUEUE_RETRY_UNTIL_MINUTES=30
